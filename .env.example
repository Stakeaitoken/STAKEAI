NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./data/stakeai.sqlite
# auto uses OpenAI when a key is configured, otherwise the local FAQ in development.
# Set ollama to use a locally installed Ollama model; set library for FAQ-only mode.
ASSISTANT_PROVIDER=auto
# Keep provider keys in .env; never expose them in browser code or commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set true to force local FAQ mode, even if a model provider is configured.
ASSISTANT_TEST_MODE=false
# Optional OpenAI-compatible API base URL. Use only for a trusted provider or local tests.
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Ollama must listen on this computer's loopback address (default port 11434).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Only these verified account emails can access /admin.html and admin APIs.
# Create and email-verify these accounts through the normal registration flow.
ADMIN_EMAILS=admin@example.com

# BNB Smart Chain testnet deployment only. Never use a mainnet key for testing.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
DEPLOYER_PRIVATE_KEY=
STAKEAI_TOKEN_ADDRESS=
STAKING_CONTRACT_ADDRESS=
# 1 preserves legacy manual rewards; use 2 with a newly deployed STAKEAIStakingV2 contract.
STAKING_CONTRACT_VERSION=1

# Generate independent random secrets of at least 32 characters.
INTERNAL_SERVICE_API_KEY=

# HTTPS destinations for the social tasks. The X task requires both URLs.
TASK_TELEGRAM_URL=
TASK_X_PROFILE_URL=
TASK_X_POST_URL=
TASK_FACEBOOK_URL=

# Required for email verification before account access is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
